# Copia este archivo a .env (en la raiz del proyecto) y rellena los valores.
#   cp .env.ejemplo .env

# Base de datos Supabase (Project Settings > Database)
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.TU_PROYECTO
DB_PASSWORD=tu_password

# Secreto para firmar las sesiones. Genera uno con:  openssl rand -base64 48
CHEFSTOOL_JWT_SECRET=cambia-esto-por-un-secreto-de-mas-de-32-caracteres

# Direccion donde abriras la aplicacion (para CORS)
CHEFSTOOL_CORS=http://localhost:8081

# Albaranes: local (volumen de Docker) o supabase (object storage)
CHEFSTOOL_ALMACEN=local
# Necesarios solo si CHEFSTOOL_ALMACEN=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documentos

# Demostracion: muestra el enlace de recuperacion de contrasena en pantalla.
# Ponlo en false cuando haya correo configurado.
CHEFSTOOL_ENLACE_DIRECTO=true
