# Copia este archivo a .env (en la raiz del proyecto) y rellena los valores.
#   cp .env.ejemplo .env

# Base de datos: PostgreSQL (el servicio "postgres" del docker-compose)
# Asi no hace falta ningun servicio externo de pago.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=chefstool
DB_USER=chefstool
DB_PASSWORD=chefstool
# En una base gestionada con SSL obligatorio (Amazon RDS): DB_SSLMODE=require
DB_SSLMODE=prefer

# Secreto para firmar las sesiones. Genera uno con:  openssl rand -base64 48
# Valor de ejemplo para probar en local. En un servidor, genera uno propio:
#   openssl rand -base64 48
CHEFSTOOL_JWT_SECRET=chefstool-local-demo-cambiar-antes-de-publicar-9f3Kq2Xr7Lm4

# Direccion donde abriras la aplicacion (para CORS)
CHEFSTOOL_CORS=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://10.*:*,http://172.16.*:*

# Albaranes: local (volumen de Docker) o s3 (bucket privado de AWS o MinIO)
CHEFSTOOL_ALMACEN=local
# Necesarios solo si CHEFSTOOL_ALMACEN=s3
CHEFSTOOL_S3_BUCKET=
CHEFSTOOL_S3_REGION=eu-south-2
# Si el servidor tiene rol IAM, deja las claves vacias. Para probar en local o MinIO:
CHEFSTOOL_S3_ENDPOINT=
CHEFSTOOL_S3_ACCESS_KEY=
CHEFSTOOL_S3_SECRET_KEY=

# Demostracion: muestra el enlace de recuperacion de contrasena en pantalla.
# Ponlo en false cuando haya correo configurado.
CHEFSTOOL_ENLACE_DIRECTO=true

# Lectura con modelo de vision (opcional). Si hay clave se usa antes que Tesseract.
# Google AI Studio (https://aistudio.google.com/apikey): gratis y sin tarjeta.
CHEFSTOOL_OCR_VISION_CLAVE=
CHEFSTOOL_OCR_VISION_MODELO=gemini-3.5-flash
