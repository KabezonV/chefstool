# Copia este archivo a .env y rellena los valores reales. .env NO se versiona.
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.TU_PROYECTO
DB_PASSWORD=tu_password

# Secreto HMAC para firmar los JWT (minimo 32 caracteres).
# Genera uno con: openssl rand -base64 48
CHEFSTOOL_JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Origenes del frontend autorizados (lista separada por comas)
CHEFSTOOL_CORS=http://localhost:5180

# Recuperacion de contrasena: sin proveedor de correo el enlace va al log.
# Ponlo a true solo en demostracion: devuelve el enlace en la respuesta.
CHEFSTOOL_ENLACE_DIRECTO=false

# Almacen de albaranes: local (disco) o supabase (object storage)
CHEFSTOOL_ALMACEN=local
CHEFSTOOL_UPLOADS=./uploads
# Necesarios si CHEFSTOOL_ALMACEN=supabase
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_del_panel_de_supabase
SUPABASE_BUCKET=documentos

# OCR: ruta del binario de Tesseract e idioma
CHEFSTOOL_OCR_TESSERACT=tesseract
CHEFSTOOL_OCR_IDIOMA=spa
