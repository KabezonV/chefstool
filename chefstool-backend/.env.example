# Copia este archivo a .env y rellena los valores reales. .env NO se versiona.
#   cp .env.example .env
#
# Solo hace falta si arrancas el backend a mano (./mvnw spring-boot:run) contra el
# PostgreSQL del docker-compose, que publica el 5433 en tu maquina.
# Para levantar todo con Docker usa el .env.ejemplo de la raiz del proyecto.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=chefstool
DB_USER=chefstool
DB_PASSWORD=chefstool
DB_SSLMODE=prefer

# Secreto HMAC para firmar los JWT (minimo 32 caracteres).
# Genera uno con: openssl rand -base64 48
CHEFSTOOL_JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+

# Origenes del frontend autorizados (lista separada por comas, admite comodines)
CHEFSTOOL_CORS=http://localhost:*,http://127.0.0.1:*

# Recuperacion de contrasena: sin proveedor de correo el enlace va al log.
# Ponlo a true solo en demostracion: devuelve el enlace en la respuesta.
CHEFSTOOL_ENLACE_DIRECTO=false

# Almacen de albaranes: local (disco) o s3 (bucket privado de AWS o MinIO)
CHEFSTOOL_ALMACEN=local
CHEFSTOOL_UPLOADS=./uploads

# OCR: ruta del binario de Tesseract e idioma (la imagen Docker ya lo trae instalado)
CHEFSTOOL_OCR_TESSERACT=tesseract
CHEFSTOOL_OCR_IDIOMA=spa
